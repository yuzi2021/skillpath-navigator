# Local development example. Copy to .env and replace the dummy values.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production defaults enable HTTPS redirects and one hour of HSTS. Override
# only if your hosting proxy does not provide HTTPS.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=3600
DB_ENGINE=postgresql
DB_NAME=skillpath
DB_USER=skillpath
DB_PASSWORD=change-me-local-only
DB_HOST=localhost
DB_PORT=5432
# Hosted platforms can provide a single connection string instead. When set,
# DATABASE_URL takes precedence over the DB_ENGINE/DB_* variables above.
# DATABASE_URL=postgresql://skillpath:password@localhost:5432/skillpath
